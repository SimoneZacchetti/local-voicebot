# Copy to .env and edit. Every key is optional; defaults shown.

# --- Providers ---
STT_PROVIDER=parakeet          # parakeet | whisper-mlx | groq
LLM_PROVIDER=ollama            # ollama | groq
PROVIDER_FALLBACK=true         # groq errors / rate limits fall back to local automatically

# --- Speech-to-text ---
STT_MODEL=mlx-community/parakeet-tdt-0.6b-v3
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo   # needs: uv sync --extra whisper
MIN_UTTERANCE_MS=200

# --- Language detection (sticky, with hysteresis) ---
DEFAULT_LANG=it
LANGID_MIN_WORDS=3             # shorter utterances keep the current language
LANGID_MIN_CONF=0.5
LANGID_MIN_MARGIN=0.3

# --- LLM (Ollama) ---
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.6:35b-a3b-nvfp4   # alternative: gemma4:26b-nvfp4 (better at math, but Ollama drops ~10% of its tool calls)
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.7
HISTORY_MAX_TURNS=12           # when reached, history is trimmed to HISTORY_KEEP_TURNS
HISTORY_KEEP_TURNS=6

# --- Text-to-speech (Kyutai Pocket TTS) ---
POCKET_PRELOAD=it,en,fr,de,es,pt,nl
POCKET_QUANTIZE=false
VOICE_IT=giovanni
VOICE_EN=alba
VOICE_FR=estelle
VOICE_DE=juergen
VOICE_ES=lola
VOICE_PT=rafael
VOICE_NL=daan

# --- Groq free tier (optional) ---
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_HISTORY_TURNS=4           # free tier is ~8K tokens/min: keep requests small
GROQ_COOLDOWN_S=60             # after an error, use local models for this long

# --- Turn-taking ---
VAD_REDEMPTION_MS=550          # silence needed before the turn ends (browser VAD)

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Latency stats (/stats page) ---
STATS_ENABLED=true             # one row per turn: timings, language, provider (never what was said)
STATS_DB=data/stats.db         # SQLite, relative to the project root
STATS_RETENTION_DAYS=90        # older rows are deleted at startup

# --- Home control via Home Assistant (optional) ---
HOME_BACKEND=none              # none | ha
HA_URL=http://homeassistant.local:8123   # with Tailscale (works away from home too): http://homeassistant:8123
HA_RETRY_S=30                  # HA unreachable at startup (VPN down): retry every N s; 0 = never
HA_TOKEN=                      # long-lived token of a dedicated NON-admin user
HA_MCP_PATH=/api/mcp           # needs the "Model Context Protocol Server" integration in HA
HA_TOOL_ALLOWLIST=             # empty = every tool HA exposes; e.g. HassTurnOn,HassTurnOff,HassLightSet,GetLiveContext
HA_ANNOUNCE_PLAYERS=           # e.g. media_player.cucina,media_player.salotto (for announcements via tts.speak)
HA_DEFAULT_PLAYER=             # e.g. Speaker Salotto: used for music/volume when no room is said
HA_TTS_ENTITY=                 # e.g. tts.google_translate_it_it (default: first tts entity)
HOME_ROUTE=ha                  # ha | google (all commands via Google cloud: works away from home) | auto
HOME_PROBE=                    # for auto: <ip>:8009 of a Google Home at home; reachable = at home, else Google
GOOGLE_FALLBACK=true           # add a google_assistant(command) tool if HA has the Google Assistant SDK integration
CONFIRM_RISKY=true             # locks, doors, gates, alarms, valves need a spoken "sì"
CONFIRM_TTL_S=30
RISKY_DOMAINS=lock,alarm_control_panel,valve,siren
TOOL_TIMEOUT_S=8
TOOL_MAX_ROUNDS=3
