# Copy to .env and edit. Every key is optional; defaults shown.

# --- Providers ---
STT_PROVIDER=parakeet          # parakeet | whisper-mlx (Apple Silicon only) | groq
LLM_PROVIDER=ollama            # ollama | groq
PROVIDER_FALLBACK=true         # groq errors / rate limits fall back to local automatically

# --- Speech-to-text ---
STT_BACKEND=auto               # auto (mlx on Apple Silicon, onnx elsewhere) | mlx | onnx
# STT_MODEL=                   # default: mlx-community/parakeet-tdt-0.6b-v3 (mlx), nemo-parakeet-tdt-0.6b-v3 (onnx)
STT_ONNX_QUANT=int8            # onnx only: int8 (faster, same accuracy) | empty = fp32
STT_THREADS=0                  # onnx only: CPU threads; 0 = auto (half the cores, max 4)
# WHISPER_MODEL=mlx-community/whisper-large-v3-turbo   # whisper-mlx only (Apple Silicon): uv sync --extra whisper
MIN_UTTERANCE_MS=200

# --- Language detection (sticky, with hysteresis) ---
DEFAULT_LANG=it
LANGID_MIN_WORDS=3             # shorter utterances keep the current language
LANGID_MIN_CONF=0.5
LANGID_MIN_MARGIN=0.3

# --- LLM (Ollama) ---
LLM_BASE_URL=http://127.0.0.1:11434   # 127.0.0.1, not localhost: Windows tries ::1 first and Ollama listens on IPv4
# Default: qwen3.6:35b-a3b-nvfp4 on Apple Silicon (alternative: gemma4:26b-nvfp4, better at math, but Ollama drops
# ~10% of its tool calls); qwen3.6:35b-a3b on Windows/other (*-nvfp4 and *-mlx tags only run on Ollama for Mac).
# Windows with < 32 GB RAM: qwen3.5:9b (16 GB RAM or 8-12 GB VRAM) or qwen3.5:4b (start.cmd picks one).
# LLM_MODEL=
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.4
LLM_THINK=auto                 # auto: reason only on hard-looking questions | off | always
LLM_THINK_BUDGET=500           # max reasoning tokens (~5 s); past it, answers without thinking
HISTORY_MAX_TURNS=12           # when reached, history is trimmed to HISTORY_KEEP_TURNS
HISTORY_KEEP_TURNS=6

# --- Text-to-speech (Kyutai Pocket TTS) ---
POCKET_PRELOAD=it,en,fr,de,es,pt,nl   # one model each; others load on first use (start.cmd: DEFAULT_LANG,en if < 32 GB)
POCKET_QUANTIZE=false
VOICE_IT=giovanni
VOICE_EN=alba
VOICE_FR=estelle
VOICE_DE=juergen
VOICE_ES=lola
VOICE_PT=rafael
VOICE_NL=daan

# --- Groq free tier (optional) ---
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_HISTORY_TURNS=4           # free tier is ~8K tokens/min: keep requests small
GROQ_COOLDOWN_S=60             # after an error, use local models for this long

# --- Turn-taking ---
VAD_REDEMPTION_MS=550          # silence needed before the turn ends (browser VAD)

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Phone access via Tailscale (docs/IPHONE.md) ---
# Start with `uv run python -m server`, publish ONLY the remote port: `tailscale serve --bg 8001`.
# Never `tailscale funnel`, never HOST=0.0.0.0, never router port forwarding.
REMOTE_ENABLED=false
REMOTE_PORT=8001
PUBLIC_HOST=                   # e.g. voicebot-mac.tailXXXX.ts.net (from `tailscale status`); add :9443 if
                               # port 443 is taken (Docker/Traefik) and you use `tailscale serve --bg --https=9443 8001`
TS_ALLOWED_LOGINS=             # your Tailscale login(s), e.g. you@gmail.com
API_TOKENS=                    # uv run python scripts/gen_secrets.py (one token per device)
API_TIMEOUT_S=20               # /api/command waits this long, then answers "running"
API_ALLOW_RISKY=false          # locks/doors/alarms from Siri: refused unless true (then /api/confirm)
API_CONFIRM_PIN=               # >= 6 digits, required with API_ALLOW_RISKY=true; a wrong PIN cancels the action

# --- Latency stats (/stats page) ---
STATS_ENABLED=true             # one row per turn: timings, language, provider (never what was said)
STATS_DB=data/stats.db         # SQLite, relative to the project root
STATS_RETENTION_DAYS=90        # older rows are deleted at startup

# --- Weather and news (free web services, no API key) ---
INFO_TOOLS=weather,news        # empty = no internet at all: the bot stays 100% local
WEATHER_LOCATION=              # empty = where you are (browser/phone position, else the public IP); or a city, or "lat,lon"
NEWS_MAX_ITEMS=5
NEWS_SEARCH=1                  # news about a topic or place via Google News search; 0 = only filter the feed below
# NEWS_FEED_IT=https://www.ansa.it/sito/ansait_rss.xml   # one RSS feed per language: IT EN FR DE ES PT NL

# --- Home control via Home Assistant (optional) ---
HOME_BACKEND=none              # none | ha
HA_URL=http://homeassistant.local:8123   # with Tailscale (works away from home too): http://homeassistant:8123
                               # Windows: .local (mDNS) names often do not resolve, use the IP or the Tailscale name
HA_RETRY_S=30                  # HA unreachable at startup (VPN down): retry every N s; 0 = never
HA_TOKEN=                      # long-lived token of a dedicated NON-admin user
HA_MCP_PATH=/api/mcp           # needs the "Model Context Protocol Server" integration in HA
HA_TOOL_ALLOWLIST=             # empty = every tool HA exposes; e.g. HassTurnOn,HassTurnOff,HassLightSet,GetLiveContext
HA_ANNOUNCE_PLAYERS=           # e.g. media_player.cucina,media_player.salotto (for announcements via tts.speak)
HA_DEFAULT_PLAYER=             # e.g. Speaker Salotto: used for music/volume when no room is said
HA_TTS_ENTITY=                 # e.g. tts.google_translate_it_it (default: first tts entity)
HOME_ROUTE=ha                  # ha | google (all commands via Google cloud: works away from home) | auto
HOME_PROBE=                    # for auto: <ip>:8009 of a Google Home at home; reachable = at home, else Google
GOOGLE_FALLBACK=true           # add a google_assistant(command) tool if HA has the Google Assistant SDK integration
CONFIRM_RISKY=true             # locks, doors, gates, alarms, valves need a spoken "sì"
CONFIRM_TTL_S=30
RISKY_DOMAINS=lock,alarm_control_panel,valve,siren
TOOL_TIMEOUT_S=8
TOOL_MAX_ROUNDS=3
