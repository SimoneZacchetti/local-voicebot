# Normalize text to LF in the repo and on checkout (also with core.autocrlf=true on Windows).
* text=auto eol=lf
*.sh text eol=lf
# Windows-only launchers: cmd.exe misparses LF-only batch files (labels, goto, parentheses).
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
# Vendored/minified web assets and models: byte-identical on every OS (service worker cache, hashes).
web/vendor/** -text
*.png binary
*.ico binary
*.wasm binary
*.onnx binary
